# ---------------------------------------------------------------------------
# resaikel - environment template
#
# Copy to `.env.local` and adjust. The defaults below are tuned for local
# development against the Firebase Emulator Suite, which needs NO cloud
# credentials at all.
#
#   cp .env.example .env.local
#   npm run emulators
#   npm run seed
#   npm run dev
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- runtime mode

# When "true" the app talks to the Firebase Emulator Suite instead of a live
# project. Turn this OFF (and fill in the FIREBASE_* service account block)
# before deploying.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# ------------------------------------------------------------------- firebase
# Client-side web app config (from Firebase console > Project settings > Web app).
# In emulator mode these values are placeholders and are never validated.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=resaikel-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=resaikel-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=resaikel-dev.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Server-side service account (Admin SDK). Required only when emulator mode is
# off. NEVER commit a real key. In production supply these through Secret
# Manager / App Hosting secrets.
FIREBASE_PROJECT_ID=resaikel-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session cookie
SESSION_COOKIE_NAME=resaikel_session
SESSION_MAX_AGE_MS=432000000

# ------------------------------------------------------------------------- ai
# "auto"  -> use live Gemini when GEMINI_API_KEY is set, otherwise the
#            deterministic mock adapter (offline-safe, zero API cost)
# "live"  -> always call Gemini; surfaces AI_UNAVAILABLE when it fails
# "mock"  -> always use fixtures; used by the automated test suite
AI_MODE=auto

# Keep this server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional fallback keys, tried in order when GEMINI_API_KEY is rate limited,
# out of quota, or rejected. Comma-separate multiple keys. (GEMINI_API_KEY may
# also hold a comma-separated list on its own.)
GEMINI_API_KEY_FALLBACKS=

# Model ids are intentionally configurable rather than hardcoded, so an outdated
# model can be swapped without a code change. Verify availability and pricing
# against current Google documentation before changing.
GEMINI_MATERIAL_MODEL=gemini-3.5-flash-lite
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
GEMINI_EXPLANATION_MODEL=gemini-3.5-flash-lite

AI_TIMEOUT_MS=45000
AI_MAX_ATTEMPTS=3
AI_DAILY_QUOTA_PER_USER=50
AI_MAX_CANDIDATES=5

# ---------------------------------------------------------------- uploads
UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_EDGE_PX=1600

# ------------------------------------------------------------- rate limiting
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------- defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=IDR
NEXT_PUBLIC_DEFAULT_COUNTRY=ID
NEXT_PUBLIC_DEFAULT_LOCALE=id-ID
