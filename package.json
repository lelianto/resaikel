{
  "name": "resaikel",
  "version": "0.1.0",
  "private": true,
  "description": "resaikel - turn waste into worth. AI-powered circular manufacturing and commerce intelligence.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "firebase emulators:start --project resaikel-dev --import=.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts",
    "verify:gemini": "node --env-file=.env.local --import tsx scripts/verify-gemini.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "check:indexes": "node --import tsx scripts/check-indexes.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "geist": "^1.3.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
