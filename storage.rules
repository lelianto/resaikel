rules_version = '2';

// resaikel - Cloud Storage security rules
//
// Material photography is private business data. Objects are never public and
// are only ever served to the browser through the authorised proxy route
// (`GET /api/materials/:id/photos/:photoId`). These rules are the second line of
// defence for direct client uploads.

service firebase.storage {
  match /b/{bucket}/o {

    function memberDoc(orgId) {
      return firestore.get(/databases/(default)/documents/organization_members/$(orgId + '_' + request.auth.uid));
    }

    function isMember(orgId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/organization_members/$(orgId + '_' + request.auth.uid))
        && memberDoc(orgId).data.status == 'active';
    }

    match /materials/{orgId}/{materialId}/{fileName} {
      allow read: if isMember(orgId);
      allow create: if isMember(orgId)
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow update: if false;
      allow delete: if isMember(orgId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
